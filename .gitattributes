# Treat binary files properly
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.xlsx binary
*.xls binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Auto normalize text files
* text=auto
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
