# Nginx reverse-proxy config for the ERP app.
# ${DOMAIN} is substituted from the container's DOMAIN env var at startup
# (the official nginx image auto-runs envsubst on files under /etc/nginx/templates/).
# Nginx's own runtime variables ($host, $scheme, etc.) are left untouched because
# they aren't set as environment variables on this container.

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Let's Encrypt HTTP-01 challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparam.pem;

    # Allow larger uploads (invoices, imports, attachments, etc.)
    client_max_body_size 25M;

    # User-uploaded media, served directly from the shared volume when the
    # app isn't configured to use Cloudinary. Harmless (empty) otherwise.
    location /media/ {
        alias /app/management_system/media/;
    }

    # Everything else — including /static/, served by whitenoise — goes to gunicorn.
    location / {
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
